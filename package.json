{
  "name": "dsh-custom-profile",
  "version": "0.6.6",
  "description": "自定义 DSH 左下角的昵称与头像：设置页里改，点保存后生效，支持缩放、位移与尺寸",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "profile",
    "avatar",
    "nickname"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojiezhenlinana/dsh-custom-profile.git"
  },
  "homepage": "https://github.com/mojiezhenlinana/dsh-custom-profile#readme",
  "bugs": {
    "url": "https://github.com/mojiezhenlinana/dsh-custom-profile/issues"
  },
  "author": "mojiezhenlinana",
  "license": "MIT"
}
